# ─────────────────────────────────────────────────────────────
# Email App settings
# `npm run setup` creates .env from this file and fills AUTH_SECRET for you.
# ─────────────────────────────────────────────────────────────

# Database file (created at prisma/dev.db). Don't change for local use.
DATABASE_URL="file:./dev.db"

# Login security key (auto-generated by `npm run setup`).
AUTH_SECRET=""

# Public address of this panel (used in password-reset and verify-email links).
# On your computer keep localhost; online use e.g. https://emails.yourdomain.com
APP_URL="http://localhost:3000"

# First admin account
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@12345678"

# ── Sending ──────────────────────────────────────────────────
# Leave empty = TEST MODE: emails are created and saved so you can view them
# in the admin panel, but nothing is delivered. Paste your Resend key to go live.
RESEND_API_KEY=""

# From Resend → Webhooks → your endpoint → Signing secret (starts with whsec_)
RESEND_WEBHOOK_SECRET=""

# "test" forces test mode even when RESEND_API_KEY is set
EMAIL_MODE="auto"
